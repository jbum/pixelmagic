// Noise Etude - Copyright 2001, Jim Bumgardner
<seq fw=360 fh=270 oversample=true framerate=24 >
  <seq debut=0 duration=4> // warp title in
    <seq id=titlea height=1 tile=true image="noiseetude.bmp" pix="sample(x,y)" />
    <seq id=fnoise center=true min=-1 width=8 endwidth=1 mono="fnoise(x,y,t*4)" />
    <seq height=1 mono="terp(1,$titlea{d+($fnoise-.5)*(.3-t*.2),a})" />
  </seq>
  <seq debut=last duration=2> // maintain with minor noise
    <seq id=titleb height=1 tile=true image="noiseetude.bmp" pix="sample(x,y)" />
    <seq id=fnoise2 center=true min=-1 width=1 mono="fnoise(x,y,4+t*2)" />
    <seq height=1 mono="$titleb{d+($fnoise2-.5)*.1,a}" />
  </seq>
  <seq debut=last duration=4> // ripple and add cloud
    <seq id=titled height=1 tile=true image="noiseetude.bmp" pix="d>.5? 1 : sample(x,y)" />
    <seq id=ripple2 min=-1 mono="sin(min(pi2,32*pi2*dist(x-.66,y-.5)-t*pi2*16))*(1-t)^2*max(0,1-dist(x-.66,y-.5)*2)*.2" />
    // <seq id=ripple2 width=16 min=-1 mono="sin(sqrt((x-7)^2+(y-10)^2)^2+(1-t)*pi*6)*.05*(1-bias(t,.7))" />
    <seq id=fnoise4 center=true min=-1 width=1 mono="fnoise(x,y,6+t*4)" />
    <seq id=cloud center=true left=2 top=2 width=4 min=-1 mono="fnoise(x+t*2,y,t)" />
    <seq id=ccloud hsv=".6-y*.25,$cloud,bias(1-$cloud,.7)" />
    <seq id=und pix="terp($titled,$ccloud)" />
    <seq height=1 pix="$und[x+($ripple2-.5)+($fnoise4-.5)*.1,y+($ripple2-.5)+($fnoise4-.5)*.1]" />
  </seq>
  <seq debut=last duration=4> // one more ripple
    <seq id=ripple3 min=-1 mono="sin(min(pi2,32*pi2*dist(x-.25,y-.25)-t*pi2*16))*(1-t)^2*max(0,1-dist(x-.25,y-.25)*2)*.3" />
    // <seq id=ripple3 width=16 min=-1 mono="sin(sqrt((x-4)^2+(y-4)^2)^2+(1-t)*pi*6)*.05*(1-bias(t,.7))" />
    <seq id=fnoise5 center=true min=-1 width=1 mono="fnoise(x,y,10+t*4)" />
    <seq id=cloud2 center=true left=2 top=2 width=4 min=-1 mono="fnoise(x+2+t*2,y,1+t)" />
    <seq id=ccloud2 hsv=".6-y*.25,$cloud2,bias(1-$cloud2,.7)" />
    <seq height=1 pix="$ccloud2[x+($ripple3-.5)+($fnoise5-.5)*.1,y+($ripple3-.5)+($fnoise5-.5)*.1]" />
  </seq>
  <seq debut=last duration=4> // fade out water and go to t=0 (turb bump here), deepen color
    <seq id=fnoise6 center=true min=-1 width=1 mono="fnoise(x,y,14+t*4)" />
    <seq id=cloud3a center=true left=2 top=2 width=4 min=-1 mono="fnoise(x+4+t*2,y,2+t)" />
    <seq id=cloud3b center=true left=2 top=2 width=4 min=-1 mono="fnoise(x+t*2-2,y,t-1)" />
    <seq id=cloud3 mono="terp($cloud3a,$cloud3b)" />
    <seq id=ccloud3 hsv="terp(.6-y*.25,.6+y*.49),$cloud3,bias(1-$cloud3,terp(.7,.5+y*.3))" />
    <seq height=1 pix="$ccloud3[x+($fnoise6-.5)*.1*(1-t),y+($fnoise6-.5)*.1*(1-t)]" />
  </seq>
  <seq debut=last duration=4> // add perspective
    <seq id=cloudpa center=true left="2+t*2" top="terp(2,0,ease(t))" width="terp(4,3,ease(t))" height="terp(3,1,ease(t))" 
        min=-1   mono="fnoise(cx+(x-cx)*(1+y)^terp(0,3.5,ease(t)),((y+t)^terp(1,3.5,ease(t))),t)" />
    <seq id=cloudpb center=true left="t*2" top="terp(2,0,ease(t))" width="terp(4,3,ease(t))" height="terp(3,1,ease(t))" 
        min=-1 mono="fnoise(cx+(x-cx)*(1+y)^terp(0,3.5,ease(t)),((y+t)^terp(1,3.5,ease(t))),t-1)" />
    <seq id=cloudp mono="terp($cloudpa,$cloudpb)" />
    <seq hsv=".6+y*.49,$cloudp,bias(1-$cloudp,.5+y*.3)" />
  </seq>
  <seq debut=last duration=8> // stay in this state (scrolling left with perspective)
    <seq id=cp1a center=true left="2+t*6" top=0 width=3 height=1 
         min=-1 mono="fnoise(cx+(x-cx)*(1+y)^3.5,(y+1)^3.5,t*2)" />
    <seq id=cp1b center=true left="t*6-4" top=0 width=3 height=1  
         min=-1 mono="fnoise(cx+(x-cx)*(1+y)^3.5,(y+1)^3.5,t*2-2)" />
    <seq id=cp1 mono="terp($cp1a,$cp1b)" />
    <seq hsv=".6+y*.49,$cp1,bias(1-$cp1,.5+y*.3)" />
  </seq>
  <seq debut=last duration=4> // play with color (still need to play with motion)
    <seq id=cp2a center=true left="2+t*2" top=0 width=3 height=1 
         min=-1 mono="fnoise(cx+(x-cx)*(1+y)^3.5,(y+1)^3.5,t)" />
    <seq id=cp2b center=true left="t*2" top=0 width=3 height=1  
         min=-1 mono="fnoise(cx+(x-cx)*(1+y)^3.5,(y+1)^3.5,t-1)" />
    <seq id=cp2 mono="terp($cp2a,$cp2b)" />
    <seq hsv=".6+y*.49,$cp2-.2*t,terp(bias(1-$cp2,.5+y*.3),bias($cp2,.4+(1-y)*.3)-.1)" />
  </seq>
  <seq debut=last duration=4> // play with z motion (todo)
    <seq id=cloudp2a center=true left="2+t*2" top=0 width="terp(3,4)" height=1 
         min=-1 mono="fnoise(cx+(x-cx)*(1+y)^3.5,(y+1)^3.5,t*terp(1,4,ease(t)))" />
    <seq id=cloudp2b center=true left="t*2" top=0 width="terp(3,4)" height=1  
         min=-1 mono="fnoise(cx+(x-cx)*(1+y)^3.5,(y+1)^3.5,t*terp(1,4,ease(t))-4)" />
    <seq id=cloudp2 mono="terp($cloudp2a,$cloudp2b)" />
    <seq hsv=".6+y*.49,$cloudp2-.2,bias($cloudp2,.4+(1-y)*.3)-.1" />
  </seq>
  <seq debut=last duration=4> // slow down z, and ease y distortion, deepen color
    <seq id=cp3a center=true left="2+t*2" top=0 width="terp(4,1)" height="1" 
         min=-1 mono="fnoise(cx+(x-cx)*(1+y)^3.5,(y+1)^3.5,t*terp(4,1,ease(t)))" />
    <seq id=cp3b center=true left="t*2" top=0 width="terp(4,1)" height="1"  
         min=-1 mono="fnoise(cx+(x-cx)*(1+y)^3.5,(y+1)^3.5,t*terp(4,1,ease(t))-1)" />
    <seq id=cp3 mono="terp($cp3a,$cp3b)" />
    <seq hsv=".6+y*.49,$cp3-.2,bias($cp3,terp(.4,.6)+(1-y)*.3)-.1" />
  </seq>
  <seq debut=last duration=8> // ease out distortions
    <seq id=cp4a center=true left="2+t*4" top=0 width=1 height="terp(1,fh/fw)" 
         min=-1 mono="fnoise(cx+(x-cx)*(1+y)^terp(3.5,0,ease(t)),(y+1)^terp(3.5,1,ease(t)),t*2)" />
    <seq id=cp4b center=true left="t*4-2" top=0 width=1 height="terp(1,fh/fw)"
        min=-1 mono="fnoise(cx+(x-cx)*(1+y)^terp(3.5,0,ease(t)),(y+1)^terp(3.5,1,ease(t)),t*2-2)" />
    <seq id=cp4 mono="terp($cp4a,$cp4b)" />
    <seq hsv=".6+y*.49,$cp4-.2,terp(bias($cp4,.6+(1-y)*.3)-.1,1-$cp4)" />
  </seq>
  <seq debut=last duration=2> // zoom out x4
    <seq id=cp5a center=true left=2 width=1 endwidth=4 min=-1 mono="fnoise(x,y+1,t*.5)" />
    <seq id=cp5b center=true left=2 width=1 endwidth=4 min=-1 mono="fnoise(x,y,t*.5-.5)" />
    <seq id=cp5 mono="terp($cp5a,$cp5b)" />
    <seq hsv=".6+y*.49,$cp5-.2,1-$cp5" />
  </seq>
  <seq debut=last duration=4> // zoom out x16
    <seq id=cp66a center=true left=2 width=4 endwidth="4*4" min=-1 mono="fnoise(x,y,t)" />
    <seq id=cp66b center=true left=2 width="4/4" endwidth=4 min=-1 mono="fnoise(x,y,t-1)" />
    <seq id=cp66 mono="terp($cp66a,$cp66b)" />
    <seq hsv=".6+y*.49,$cp66-terp(.2,.5),1-$cp66" />
  </seq>
  <seq debut=last duration=8> // zoom out x32
    <seq id=cp6a center=true left=2 width=4 endwidth="4*8" min=-1 mono="fnoise(x,y,t*2)" />
    <seq id=cp6b center=true left=2 width="4/8" endwidth=4 min=-1 mono="fnoise(x,y,t*2-2)" />
    <seq id=cp6 mono="terp($cp6a,$cp6b)" />
    <seq hsv=".6+y*.49,$cp6-.5,1-$cp6" />
  </seq>
  <seq debut=last duration=16> // zoom out x512 onto turb
    <seq id=cp7a center=true left=2 width=4 endwidth="4*128" min=-1 mono="fnoise(x,y,t*4)" />
    <seq id=cp7b center=true left=2 width="4/128" endwidth=4 min=-1 mono="turb(x,y,t*4-4)" />
    <seq id=cp7 mono="terp($cp7a,$cp7b,ease(t))" />
    <seq hsv=".6+y*.49,$cp7-.5,1-$cp7" />
  </seq>
  <seq debut=last duration=4> // zoom out -> zoom in -> turb
    <seq id=cp8a center=true left=2 width=4 endwidth="4*2" min=-1 mono="turb(x,y,t)" />
    <seq id=cp8b center=true left=2 width=8 endwidth=4 mono="turb(x,y,t-1)" />
    <seq id=cp8 mono="terp($cp8a,$cp8b,ease(t))" />
    <seq hsv=".6+y*.49,$cp8-.5,1-$cp8" />
  </seq>
  <seq debut=last duration=16> // zoom in, modify coloring
    <seq id=cp9a center=true left=2 width=4 endwidth="4/256" mono="turb(x,y,t*terp(4,1,ease(t)))" />
    <seq id=cp9b center=true left=2 width="4*256" endwidth=4 
          mono="sqrt(turb(x,y,t*terp(8,4,ease(t))-4))" />
    <seq id=n9 center=true left=2 width=4 mono="noise(x,y,t*4-4)" />
    <seq id=cp9 mono="terp($cp9a,$cp9b,ease(t))" />
    <seq hsv="terp(.6,$n9)+y*terp(.49,1),$cp9-.5,1-$cp9" />
  </seq>
  <seq debut=last duration=8> // hold and morph
    <seq id=n10 center=true left=2 width=4 mono="noise(x,y,t*2)" />
    <seq id=cp10 center=true left=2 width=4 mono="sqrt(turb(x,y,t*2))" />
    <seq id=c10 hsv="y+$n10,$cp10-.5,1-$cp10" />
  </seq>
  <seq debut=last duration=16> // fade out
    <seq id=n11 center=true left=2 width=4 mono="noise(x,y,t*4+2)" />
    <seq id=cp11 center=true left=2 width=4 mono="sqrt(turb(x,y,t*4+2))" />
    <seq id=c11 hsv="y+$n11,$cp11-.5,1-$cp11" />
    <seq pix="terp($c11,0,bias(t,.3))" />
  </seq>
  <seq debut=last duration=1 mono="0" /> // hold black
  <seq debut=last duration=6> // end credit
    <seq debut=0 duration=1 height=1 tile=true image="endcredit.bmp" pix="terp(0,sample(x,y),ease(t))" />
    <seq debut=last duration=3 height=1 tile=true image="endcredit.bmp" pix="sample(x,y)" />
    <seq debut=last duration=2 height=1 tile=true image="endcredit.bmp" pix="terp(sample(x,y),0,ease(t))" />
  </seq>
</seq>
